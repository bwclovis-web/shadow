# Database URLs for migration script
# Copy this file to .env in the project root and fill in your values

# Local PostgreSQL database (source)
LOCAL_DATABASE_URL="postgresql://postgres:password@localhost:5432/new_scent"

# Remote Prisma Accelerate database (destination)
REMOTE_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"

# Main database URL used by the application (typically points to local for development)
DATABASE_URL="postgresql://postgres:password@localhost:5432/new_scent"

# Sanity CMS — Behind the Bottle blog (optional)
# Run: npm run sanity:check  after filling these in
# NEXT_PUBLIC_* is used by Next.js; sanity dev also reads these (or SANITY_STUDIO_* aliases)
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-05-17"
# Optional aliases for standalone studio (sanity dev) — defaults to NEXT_PUBLIC_* if omitted
# SANITY_STUDIO_PROJECT_ID=""
# SANITY_STUDIO_DATASET="production"
# Optional: read token for draft preview (not required for published content)
SANITY_API_READ_TOKEN=""
# Optional: POST /api/sanity/revalidate when articles publish (Bearer token)
SANITY_REVALIDATE_SECRET=""

# Web Push (optional) — run: node scripts/generate-vapid-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@yourdomain.com"
