generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  password              String
  firstName             String?
  lastName              String?
  username              String                 @unique
  /// URL path segment for /{profileSlug}/profile; unique; may differ from slug(username) when disambiguating collisions.
  profileSlug           String?                @unique
  traderAbout            String?
  avatarImage           String?
  region                String?
  instagramHandle       String?
  fragranticaUrl        String?
  redditUsername        String?
  strikeCount           Int                    @default(0)
  isBanned              Boolean                @default(false)
  onboardingCompletedAt       DateTime?
  onboardingMatchesViewedAt   DateTime?
  lastActiveAt                DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  role                  UserRole               @default(user)
  subscriptionStatus    SubscriptionStatus     @default(free)
  subscriptionId        String?
  subscriptionStartDate DateTime?
  isEarlyAdopter        Boolean                @default(false)
  tokenVersion          Int                    @default(0)
  totpSecretEncrypted   String?
  twoFactorEnabledAt    DateTime?
  failedLoginAttempts   Int                    @default(0)
  lastFailedLoginAt     DateTime?
  SecurityAuditLog      SecurityAuditLog[]
  loginEvents           UserLoginEvent[]
  twoFactorBackupCodes  UserTwoFactorBackupCode[]
  UserAlert             UserAlert[]
  alertPreferences      UserAlertPreferences?
  pushSubscriptions     UserPushSubscription[]
  conversationPresence  UserConversationPresence?
  UserPerfume           UserPerfume[]
  userPerfumeComments   UserPerfumeComment[]
  UserPerfumeRating     UserPerfumeRating[]
  UserPerfumeSeasonVote UserPerfumeSeasonVote[]
  UserPerfumeReview     UserPerfumeReview[]
  UserPerfumeWishlist   UserPerfumeWishlist[]
  wishlistNotifications WishlistNotification[]
  traderFeedbackReceived TraderFeedback[] @relation("FeedbackForTrader")
  traderFeedbackLeft     TraderFeedback[] @relation("FeedbackFromReviewer")
  traderFeedbackHelpfulnessVotes TraderFeedbackHelpfulnessVote[]
  pendingSubmissions    PendingSubmission[] @relation("SubmittedSubmissions")
  reviewedSubmissions   PendingSubmission[] @relation("ReviewedSubmissions")
  traderContactMessagesSent TraderContactMessage[] @relation("ContactMessagesSent")
  traderContactMessagesReceived TraderContactMessage[] @relation("ContactMessagesReceived")
  tradesInitiated       Trade[]                @relation("TradesInitiated")
  tradesAsCounterparty  Trade[]                @relation("TradesAsCounterparty")
  tradeEvents           TradeEvent[]           @relation("TradeEventActor")
  strikesReceived       UserStrike[]           @relation("StrikesReceived")
  strikesIssued         UserStrike[]           @relation("StrikesIssued")
  reportsFiled          UserReport[]           @relation("ReportsFiled")
  reportsReceived       UserReport[]           @relation("ReportsReceived")
  disputesInitiated     TradeDispute[]         @relation("DisputesInitiated")
  disputesAsOtherParty  TradeDispute[]         @relation("DisputesAsOtherParty")
  disputesResolved      TradeDispute[]         @relation("DisputesResolvedByAdmin")
  ScentProfile              ScentProfile?
  follows                   UserFollow[]         @relation("UserFollows")
  followedBy                UserFollow[]         @relation("UserFollowedBy")
  decantSplitsHosted        DecantSplit[]        @relation("DecantSplitsHosted")
  decantSplitSlotsClaimed   DecantSplitSlot[]    @relation("DecantSplitSlotsClaimed")
  decantSplitEvents         DecantSplitEvent[]   @relation("DecantSplitEventActor")
  submittedPerfumes         Perfume[]            @relation("PerfumeSubmittedByUser")
  submittedPerfumeHouses    PerfumeHouse[]       @relation("PerfumeHouseSubmittedByUser")
}

model PerfumeHouse {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  image       String?
  website     String?
  country     String?
  founded     String?
  email       String?
  phone       String?
  address     String?
  type        HouseType @default(indie)
  isPending   Boolean   @default(false)
  submittedBy String?
  pendingSubmissionId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  slug        String    @unique
  perfumes    Perfume[]
  followedBy  UserFollow[]
  submittedByUser User? @relation("PerfumeHouseSubmittedByUser", fields: [submittedBy], references: [id])

  @@index([type, name], name: "idx_house_type_name")
  @@index([submittedBy], name: "idx_house_submitted_by")
  @@index([isPending, submittedBy], name: "idx_house_pending_submitted_by")
  @@index([pendingSubmissionId], name: "idx_house_pending_submission")
}

/// One row per UTC calendar day; written by cron for trend charts on the data quality dashboard.
model DataQualityDailySnapshot {
  id                    String   @id @default(cuid())
  snapshotDate          DateTime @unique @db.Date
  totalMissing          Int
  totalDuplicates       Int
  totalMissingHouseInfo Int
  totalHousesNoPerfumes Int
  createdAt             DateTime @default(now())
}

model Perfume {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  image                 String?
  perfumeHouseId        String?
  isPending             Boolean                @default(false)
  submittedBy           String?
  pendingSubmissionId   String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  slug                  String                 @unique
  perfumeHouse          PerfumeHouse?          @relation(fields: [perfumeHouseId], references: [id])
  submittedByUser       User?                  @relation("PerfumeSubmittedByUser", fields: [submittedBy], references: [id])
  
  // Junction table relation
  perfumeNoteRelations  PerfumeNoteRelation[]
  
  UserAlert             UserAlert[]
  userPerfume           UserPerfume[]
  userPerfumeComments   UserPerfumeComment[]
  userPerfumeRating     UserPerfumeRating[]
  userPerfumeSeasonVote UserPerfumeSeasonVote[]
  userPerfumeReview     UserPerfumeReview[]
  userPerfumeWishlist   UserPerfumeWishlist[]
  wishlistNotifications WishlistNotification[]
  followedBy            UserFollow[]
  decantSplits          DecantSplit[]

  @@index([slug], name: "idx_perfume_slug")
  @@index([perfumeHouseId, createdAt], name: "idx_perfume_house_created")
  @@index([name], name: "idx_perfume_name")
  @@index([submittedBy], name: "idx_perfume_submitted_by")
  @@index([isPending, submittedBy], name: "idx_perfume_pending_submitted_by")
  @@index([pendingSubmissionId], name: "idx_perfume_pending_submission")
}

model UserPerfume {
  id                  String               @id @default(cuid())
  userId              String
  perfumeId           String
  amount              String               @default("0")
  available           String               @default("0")
  pausedAvailable     String?
  price               String?
  placeOfPurchase     String?
  tradePrice          String?
  tradePreference     TradePreference      @default(cash)
  tradeOnly           Boolean              @default(false)
  images              String[]             @default([])
  condition           ListingCondition?
  decantFormat        DecantFormat?
  mlRemaining         Float?
  pendingSubmissionId String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  type                PerfumeType          @default(eauDeParfum)
  perfume             Perfume              @relation(fields: [perfumeId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  pendingSubmission   PendingSubmission?   @relation(fields: [pendingSubmissionId], references: [id])
  comments            UserPerfumeComment[]
  tradeLineItems      TradeLineItem[]
  decantSplitsSourced DecantSplit[]      @relation("DecantSplitSource")

  @@index([userId, available], name: "idx_user_perfume_user_available")
  @@index([perfumeId, available], name: "idx_user_perfume_perfume_available")
  @@index([pendingSubmissionId])
}

model UserPerfumeRating {
  id         String   @id @default(cuid())
  userId     String
  perfumeId  String
  createdAt  DateTime @default(now())
  gender     Int?
  longevity  Int?
  overall    Int?
  priceValue Int?
  sillage    Int?
  updatedAt  DateTime @updatedAt
  perfume    Perfume  @relation(fields: [perfumeId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, perfumeId])
  @@index([perfumeId, overall], name: "idx_rating_perfume_overall")
}

model UserPerfumeSeasonVote {
  id        String   @id @default(cuid())
  userId    String
  perfumeId String
  winter    Boolean  @default(false)
  spring    Boolean  @default(false)
  summer    Boolean  @default(false)
  fall      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  perfume   Perfume  @relation(fields: [perfumeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, perfumeId])
  @@index([perfumeId], name: "idx_season_vote_perfume")
}

model UserPerfumeReview {
  id         String   @id @default(cuid())
  userId     String
  perfumeId  String
  review     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isApproved Boolean  @default(true)
  perfume    Perfume  @relation(fields: [perfumeId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, perfumeId])
  @@index([perfumeId, createdAt], name: "idx_review_perfume_created")
}

model UserPerfumeWishlist {
  id               String                   @id @default(cuid())
  userId           String
  perfumeId        String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now()) @updatedAt
  isPublic         Boolean                  @default(false)
  bottlePreference WishlistBottlePreference @default(any)
  perfume          Perfume                  @relation(fields: [perfumeId], references: [id])
  user             User                     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], name: "idx_wishlist_user_created")
  @@index([perfumeId], name: "idx_wishlist_perfume")
}

model UserPerfumeComment {
  id            String      @id @default(cuid())
  userId        String
  perfumeId     String
  userPerfumeId String
  comment       String
  isPublic      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  perfume       Perfume     @relation(fields: [perfumeId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  userPerfume   UserPerfume @relation(fields: [userPerfumeId], references: [id])
}

model PerfumeNotes {
  id             String   @id @default(cuid())
  name           String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  
  // Legacy columns (preserved from remote database)
  perfumeOpenId  String?
  perfumeHeartId String?
  perfumeCloseId String?
  
  // Junction table relation
  perfumeNoteRelations PerfumeNoteRelation[]
  materialAliases      NoteMaterialAlias[]
}

/// Canonical scent material for quiz preferences and recommendation rollup (e.g. bergamot).
model NoteMaterial {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  family    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases NoteMaterialAlias[]
}

enum NoteMaterialAliasSource {
  seed
  rule
  manual
}

/// Maps an existing PerfumeNotes row to a NoteMaterial without changing the note name.
model NoteMaterialAlias {
  id         String                  @id @default(cuid())
  materialId String
  noteId     String                  @unique
  source     NoteMaterialAliasSource @default(seed)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  material NoteMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  note     PerfumeNotes @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([materialId])
}

// New junction table
model PerfumeNoteRelation {
  id         String         @id @default(cuid())
  perfumeId  String
  noteId     String
  noteType   PerfumeNoteType
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt
  
  perfume    Perfume        @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  note       PerfumeNotes   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  @@unique([perfumeId, noteId, noteType])
  @@index([perfumeId])
  @@index([noteId])
  @@index([noteType])
  @@index([noteId, noteType], name: "idx_note_relation_note_type")
}

model WishlistNotification {
  id         String   @id @default(cuid())
  userId     String
  perfumeId  String
  notifiedAt DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  perfume    Perfume  @relation(fields: [perfumeId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, perfumeId])
}

enum TraderFeedbackHelpfulness {
  helpful
  unhelpful
}

model TraderFeedback {
  id             String   @id @default(cuid())
  traderId       String
  reviewerId     String
  tradeId        String?
  rating         Int      /// Expected 1-5 scale; enforce in application logic.
  comment        String?
  helpfulCount   Int      @default(0)
  unhelpfulCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  trader         User     @relation("FeedbackForTrader", fields: [traderId], references: [id])
  reviewer       User     @relation("FeedbackFromReviewer", fields: [reviewerId], references: [id])
  trade          Trade?   @relation(fields: [tradeId], references: [id])
  helpfulnessVotes TraderFeedbackHelpfulnessVote[]

  @@unique([traderId, reviewerId])
  @@index([traderId])
  @@index([reviewerId])
  @@index([tradeId])
}

model TraderFeedbackHelpfulnessVote {
  id         String                    @id @default(cuid())
  feedbackId String
  voterId    String
  value      TraderFeedbackHelpfulness
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  feedback   TraderFeedback            @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  voter      User                      @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, voterId])
  @@index([feedbackId])
  @@index([voterId])
}

model UserTwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SecurityAuditLog {
  id         String                @id
  userId     String?
  action     SecurityAuditAction
  severity   SecurityAuditSeverity @default(info)
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  metadata   Json?
  createdAt  DateTime              @default(now())
  User       User?                 @relation(fields: [userId], references: [id])
}

model UserLoginEvent {
  id                String   @id @default(cuid())
  userId            String
  success           Boolean
  failureReason     String?
  deviceFingerprint String
  countryCode       String?
  ipHash            String
  userAgent         String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, deviceFingerprint])
}

model UserAlert {
  id          String    @id @default(cuid())
  userId      String
  perfumeId   String?
  alertType   AlertType
  title       String
  message     String
  isRead      Boolean   @default(false)
  isDismissed Boolean   @default(false)
  metadata    Json?
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  dismissedAt DateTime?
  Perfume     Perfume?  @relation(fields: [perfumeId], references: [id])
  User        User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, isRead, isDismissed])
}

model UserAlertPreferences {
  id                    String  @id @default(cuid())
  userId                String  @unique
  wishlistAlertsEnabled Boolean @default(true)
  decantAlertsEnabled   Boolean @default(true)
  emailWishlistAlerts   Boolean @default(false)
  emailDecantAlerts     Boolean @default(false)
  emailTradeAlerts      Boolean @default(false)
  emailSecurityAlerts   Boolean @default(true)
  securityAlertsEnabled Boolean @default(true)
  followAlertsEnabled   Boolean @default(true)
  emailFollowAlerts     Boolean @default(false)
  emailSubmissionAlerts Boolean @default(false)
  pushEnabled           Boolean @default(false)
  pushTradeAlerts       Boolean @default(true)
  pushMessageAlerts     Boolean @default(true)
  pushFollowAlerts      Boolean @default(true)
  pushSubmissionAlerts  Boolean @default(true)
  maxAlerts             Int     @default(10)
  User                  User    @relation(fields: [userId], references: [id])
}

model UserFollow {
  id                 String   @id @default(cuid())
  followerId         String
  followingUserId    String?
  followingHouseId   String?
  followingPerfumeId String?
  createdAt          DateTime @default(now())

  follower         User          @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  followingUser    User?         @relation("UserFollowedBy", fields: [followingUserId], references: [id], onDelete: Cascade)
  followingHouse   PerfumeHouse? @relation(fields: [followingHouseId], references: [id], onDelete: Cascade)
  followingPerfume Perfume?      @relation(fields: [followingPerfumeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingUserId])
  @@unique([followerId, followingHouseId])
  @@unique([followerId, followingPerfumeId])
  @@index([followingUserId])
  @@index([followingHouseId])
  @@index([followingPerfumeId])
}

model UserPushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserConversationPresence {
  userId            String   @id
  counterpartUserId String?
  updatedAt         DateTime @updatedAt
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingSubmission {
  id            String                @id @default(cuid())
  submissionType PendingSubmissionType
  submittedBy   String?
  status         PendingSubmissionStatus @default(pending)
  submissionData Json
  adminNotes     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  submittedByUser User?               @relation("SubmittedSubmissions", fields: [submittedBy], references: [id])
  reviewedByUser User?                @relation("ReviewedSubmissions", fields: [reviewedBy], references: [id])
  userPerfumes   UserPerfume[]

  @@index([status, createdAt])
  @@index([submissionType, status])
}

model TraderContactMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  tradeId     String?
  subject     String?
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  sender      User     @relation("ContactMessagesSent", fields: [senderId], references: [id])
  recipient   User     @relation("ContactMessagesReceived", fields: [recipientId], references: [id])
  trade       Trade?   @relation(fields: [tradeId], references: [id])

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@index([tradeId])
}

model Trade {
  id             String       @id @default(cuid())
  initiatorId    String
  counterpartyId String
  status         TradeStatus  @default(draft)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  initiator      User         @relation("TradesInitiated", fields: [initiatorId], references: [id])
  counterparty   User         @relation("TradesAsCounterparty", fields: [counterpartyId], references: [id])
  lineItems      TradeLineItem[]
  events         TradeEvent[]
  contactMessages TraderContactMessage[]
  feedback       TraderFeedback[]
  disputes       TradeDispute[]

  @@index([initiatorId, status])
  @@index([counterpartyId, status])
  @@index([status, updatedAt])
}

model TradeLineItem {
  id                String            @id @default(cuid())
  tradeId           String
  userPerfumeId     String
  role              TradeLineItemRole
  perfumeName       String
  mlSnapshot        Float?
  conditionSnapshot ListingCondition?
  trade             Trade             @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  userPerfume       UserPerfume       @relation(fields: [userPerfumeId], references: [id])

  @@index([tradeId])
  @@index([userPerfumeId])
}

model TradeEvent {
  id          String   @id @default(cuid())
  tradeId     String
  type        String
  actorUserId String
  metadata    Json?
  createdAt   DateTime @default(now())
  trade       Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  actor       User     @relation("TradeEventActor", fields: [actorUserId], references: [id])

  @@index([tradeId, createdAt])
  @@index([actorUserId])
}

model DecantSplit {
  id                  String            @id @default(cuid())
  hostUserId          String
  perfumeId           String
  sourceUserPerfumeId String?
  totalMl             Float
  status              DecantSplitStatus @default(open)
  priceHint           String?
  notes               String?
  decantFormat        DecantFormat?
  condition           ListingCondition?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  shippedAt           DateTime?
  completedAt         DateTime?
  host                User              @relation("DecantSplitsHosted", fields: [hostUserId], references: [id])
  perfume             Perfume           @relation(fields: [perfumeId], references: [id])
  sourceUserPerfume   UserPerfume?      @relation("DecantSplitSource", fields: [sourceUserPerfumeId], references: [id])
  slots               DecantSplitSlot[]
  events              DecantSplitEvent[]

  @@index([hostUserId, status])
  @@index([perfumeId, status])
}

model DecantSplitSlot {
  id             String                @id @default(cuid())
  splitId        String
  ml             Float
  status         DecantSplitSlotStatus @default(open)
  claimantUserId String?
  claimedAt      DateTime?
  paidAt         DateTime?
  receivedAt     DateTime?
  split          DecantSplit           @relation(fields: [splitId], references: [id], onDelete: Cascade)
  claimant       User?                 @relation("DecantSplitSlotsClaimed", fields: [claimantUserId], references: [id])

  @@index([splitId, status])
  @@index([claimantUserId])
}

model DecantSplitEvent {
  id          String      @id @default(cuid())
  splitId     String
  type        String
  actorUserId String
  metadata    Json?
  createdAt   DateTime    @default(now())
  split       DecantSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  actor       User        @relation("DecantSplitEventActor", fields: [actorUserId], references: [id])

  @@index([splitId, createdAt])
  @@index([actorUserId])
}

model UserStrike {
  id        String   @id @default(cuid())
  userId    String
  issuedBy  String
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation("StrikesReceived", fields: [userId], references: [id])
  issuer    User     @relation("StrikesIssued", fields: [issuedBy], references: [id])

  @@index([userId, createdAt])
  @@index([issuedBy])
}

model UserReport {
  id             String             @id @default(cuid())
  reporterId     String
  reportedUserId String
  category       UserReportCategory
  description    String?
  images         String[]           @default([])
  status         UserReportStatus   @default(inProgress)
  createdAt      DateTime           @default(now())
  reporter       User               @relation("ReportsFiled", fields: [reporterId], references: [id])
  reportedUser   User               @relation("ReportsReceived", fields: [reportedUserId], references: [id])

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([reporterId])
}

model TradeDispute {
  id                  String                     @id @default(cuid())
  tradeId             String
  initiatedByUserId   String
  otherPartyUserId    String
  category            DisputeCategory
  description         String?
  images              String[]                   @default([])
  status              DisputeStatus              @default(open)
  adminNotes          String?
  resolutionOutcome   DisputeResolutionOutcome?
  publicSummary       String?
  resolvedAt          DateTime?
  resolvedByAdminId   String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  trade               Trade                      @relation(fields: [tradeId], references: [id])
  initiatedBy         User                       @relation("DisputesInitiated", fields: [initiatedByUserId], references: [id])
  otherParty          User                       @relation("DisputesAsOtherParty", fields: [otherPartyUserId], references: [id])
  resolvedByAdmin     User?                      @relation("DisputesResolvedByAdmin", fields: [resolvedByAdminId], references: [id])

  @@index([status, createdAt])
  @@index([tradeId])
  @@index([initiatedByUserId])
  @@index([otherPartyUserId])
}

model ScentProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  noteWeights         Json     // { noteId: number }
  avoidNoteIds        Json     // string[]
  materialWeights     Json     @default("{}") // { materialId: number }
  materialAvoidIds    Json     @default("[]") // string[]
  preferredPriceRange    Json?    // { min?: number, max?: number }
  preferredConcentration String?  // "edt" | "edp" | "parfum" | null (no preference)
  preferredHouseTier     String?  // "designer" | "niche" | "indie" | "all"
  seasonHint             String?  // comma-separated: "spring", "summer,fall", etc.
  browsingStyle          String?  // "explorer" | "focused" | "trader"
  lastQuizAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Migration state tracking for incremental syncs
